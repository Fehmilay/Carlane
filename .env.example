# CARLANE — local environment (copy to .env, never commit real keys)
#
# RevenueCat *public* iOS SDK key (RevenueCat dashboard → Project → API keys → App-specific keys → iOS, "appl_…").
# Leave it empty (or omit the .env file) and the app uses the mock store: every purchase succeeds after 400 ms,
# which is what the web build, the screenshot tool and the smoke test rely on.
# The value is inlined into the JS bundle at build time (Vite), so run `npm run build && npx cap sync ios` after changing it.
VITE_REVENUECAT_IOS_KEY=
